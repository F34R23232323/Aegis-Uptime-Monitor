{
	"name": "aegis-web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"build": "vite build",
		"preview": "vite preview --host 0.0.0.0",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"e2e": "playwright test"
	},
	"dependencies": {
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"svelte": "^5.57.1",
		"bits-ui": "^2.0.0",
		"tailwindcss": "^4.1.0",
		"@tailwindcss/vite": "^4.1.0",
		"@lucide/svelte": "^1.73.0"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"vite": "^8.3.8",
		"typescript": "^6.0.0",
		"svelte-check": "^4.3.0",
		"vitest": "^5.1.0",
		"@types/node": "^24.0.0",
		"prettier": "^3.6.0",
		"prettier-plugin-svelte": "^3.4.0",
		"@playwright/test": "^1.56.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
