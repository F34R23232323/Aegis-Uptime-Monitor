# /etc/aegis/agent.env, mode 0600, owned by the service user
AEGIS_URL=https://status.example.com
AEGIS_AGENT_TOKEN=replace-with-enrollment-token
# Only enable after understanding Docker socket privileges.
AEGIS_DOCKER=false
# Run as the PM2 owner. Colon-delimited adapter homes; no shell is invoked.
AEGIS_PM2_HOMES=/home/bot/.pm2
AEGIS_PM2_BINARY=/usr/local/bin/pm2
