# Install as /etc/aegis/api.env, owned by root:aegis with mode 0640.
APP_ENV=production
APP_URL=https://status.example.com
DATABASE_URL=postgres://aegis:REPLACE_ME@127.0.0.1:5432/aegis
ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Required only until the first owner is enrolled. Remove it afterwards.
BOOTSTRAP_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ALLOW_PRIVATE_TARGETS=false
RUST_LOG=info
# Optional: opens the loopback-only /metrics endpoint to a bearer-authenticated scraper.
METRICS_TOKEN=
