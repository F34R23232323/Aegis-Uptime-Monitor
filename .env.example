# Aegis Monitor Docker Compose configuration
# ------------------------------------------
# Copy this file to .env in the project root, then fill in the required secrets.
# Docker Compose reads .env when you run it from this directory. Keep .env private;
# it contains credentials and must never be committed or included in screenshots.
# The values below are for the supplied Compose stack. Native systemd installs use
# deploy/api.env.example and deploy/agent.env.example instead.
#
# Local setup:       docker compose up -d --build
# Production HTTPS:  docker compose -f compose.yaml -f compose.production.yaml up -d --build
# Optional agent:    docker compose --profile agent up -d --build
#
# Generate each secret independently. Do not copy a value from one secret to another.
# On Linux/macOS, use "openssl rand -hex 24" and "openssl rand -hex 32" as noted below.

# DATABASE ---------------------------------------------------------------

# Required. Password for the "aegis" PostgreSQL role in the bundled database.
# The API also uses this value in its DATABASE_URL. Use URL-safe characters so the
# generated connection URL remains valid; "openssl rand -hex 24" is suitable.
# Changing this value after the database is initialized does NOT change the
# existing PostgreSQL role password. Rotate the role password separately.
POSTGRES_PASSWORD=

# Required. 32 random bytes encoded as exactly 64 hex characters; generate with
# "openssl rand -hex 32". Encrypts stored monitor credentials and webhook secrets.
# Keep a protected copy alongside your database backup: losing or changing this
# key makes previously encrypted values unreadable. Never publish it.
ENCRYPTION_KEY=

# APPLICATION ORIGIN AND APPEARANCE ------------------------------------

# The exact URL users open in their browser, including scheme and non-default
# port. It controls trusted Origin checks and the web server's ORIGIN setting.
# Use only the origin: no path, trailing slash, query, or embedded credentials.
# For local use, keep this in sync with PORT (for example, localhost:8081).
# In the production Compose overlay, AEGIS_DOMAIN sets the effective HTTPS
# APP_URL and ORIGIN, so set AEGIS_DOMAIN to the same hostname you intend to use.
APP_URL=http://localhost:8080

# Display name used in the app, login screen, and notification branding.
APP_NAME=Aegis Monitor

# Default UI accent color as a six-digit hex code. Keep quotes: # is special in
# Compose/YAML contexts. Status pages may also have their own accent settings.
APP_ACCENT="#a18aff"

# Host-side port for the local gateway, bound to 127.0.0.1 only. This does not
# publish the API, web service, or database directly. Change APP_URL to match.
# The production overlay removes this binding and exposes Caddy on 80/443.
PORT=8080

# CHECKS AND OBSERVABILITY ----------------------------------------------

# Security opt-in for monitors that target private, LAN, loopback, or other
# reserved addresses reachable from the API container. Leave false unless
# trusted administrators need that access. It expands the network targets an
# admin can probe; use network egress controls on shared installations.
ALLOW_PRIVATE_TARGETS=false

# Maximum concurrent scheduled checks claimed per batch. Default 16; the API
# clamps values to the 1-128 range. Raise only if the host and targets can cope.
CHECK_WORKERS=16

# Optional. A random bearer token of at least 32 characters enables the API's
# internal Prometheus /metrics endpoint. Blank disables it. The public gateway
# does not route this endpoint; scrape the private API port from a trusted network
# with Authorization: Bearer <token>. Generate with "openssl rand -hex 32".
METRICS_TOKEN=

# Rust tracing filter for API logs. The example emits info logs while reducing
# SQLx noise. Avoid verbose logging of requests that may contain credentials.
RUST_LOG=info,sqlx=warn

# OPTIONAL COMPOSE AGENT -------------------------------------------------
# These settings apply only when you start the "agent" Compose profile. You can
# also enroll an agent on another server using the separate native agent guide.

# URL the agent uses to send heartbeats. This default reaches the gateway inside
# the Compose network, NOT a public browser URL. Use HTTPS for a remote agent.
AEGIS_URL=http://gateway:8080

# Credential issued by Servers -> Connect server in the UI after enrollment.
# Leave empty until you enroll; a running agent requires a valid token. Treat it
# as a secret and rotate/revoke it in the UI if exposed.
AEGIS_AGENT_TOKEN=

# Permit an HTTP AEGIS_URL for local development or a trusted internal network.
# The agent refuses HTTP when false. If you use the default http://gateway:8080
# with the Compose agent profile, explicitly set this to true after considering
# that traffic on that network is unencrypted. Keep false for an HTTPS agent URL.
ALLOW_INSECURE_HTTP=false

# PRODUCTION HTTPS -------------------------------------------------------

# Development permits the local HTTP origin. Production requires HTTPS and a
# bootstrap token until the first Owner account is created.
APP_ENV=development

# Your own DNS hostname (no scheme or path), pointing at this host. Required
# only with compose.production.yaml. Caddy uses it for HTTPS certificates, and
# the overlay sets APP_URL/ORIGIN to https://<AEGIS_DOMAIN> regardless of the
# APP_URL value above. Open TCP 80/443 to this host when using public HTTPS.
AEGIS_DOMAIN=

# Required for the first Owner account in production. Generate a separate
# random value of at least 32 characters, for example "openssl rand -hex 32".
# Enter it in the first-run setup form; never put it in a URL or log. After the
# Owner account is created, remove it from .env and recreate the API container.
# Leave blank for the default local development setup.
BOOTSTRAP_TOKEN=

# ADVANCED PROXY ENVIRONMENTS --------------------------------------------

# Compose adds internal service names to NO_PROXY for the web, Caddy, and agent
# containers so a host proxy cannot intercept their private calls. If your
# environment already defines NO_PROXY, Compose appends it. Usually leave this
# unset; set it only when your proxy setup needs additional bypass destinations.
# NO_PROXY=example.internal
