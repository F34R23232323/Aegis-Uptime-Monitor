# Copy to .env. Generate each secret independently; never commit .env.
# Keep POSTGRES_PASSWORD URL-safe: openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32. Back up this key with the database.
ENCRYPTION_KEY=
APP_URL=http://localhost:8080
APP_NAME=Aegis Monitor
APP_ACCENT="#a18aff"
PORT=8080
# Explicit opt-in: trusted admins can then probe private/LAN/loopback addresses.
ALLOW_PRIVATE_TARGETS=false
CHECK_WORKERS=16
# Optional internal Prometheus exporter on API port /metrics; opens only with a 32+ character bearer token.
METRICS_TOKEN=
RUST_LOG=info,sqlx=warn
# Optional Docker-profile agent: enroll a server in the UI first.
AEGIS_URL=http://gateway:8080
AEGIS_AGENT_TOKEN=
ALLOW_INSECURE_HTTP=false
# Production: use compose.production.yaml with your DNS hostname.
# APP_ENV=production requires an HTTPS APP_URL.
APP_ENV=development
AEGIS_DOMAIN=

# Required for first-owner setup in production. openssl rand -hex 32
BOOTSTRAP_TOKEN=
